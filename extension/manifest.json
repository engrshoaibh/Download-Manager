{
  "manifest_version": 3,
  "name": "Download Manager Pro Integration",
  "short_name": "DM Capture",
  "version": "1.9.0",
  "key": "",
  "description": "IDM-style sniffer — HLS/DASH/MP4 capture, YouTube quality menu, daemon handoff.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Download Manager Pro"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/sniffer.js"],
      "css": ["content/sniffer.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/player-hooks.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "permissions": [
    "downloads",
    "contextMenus",
    "cookies",
    "storage",
    "tabs",
    "notifications",
    "scripting",
    "webRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:7373/*",
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["capture/capture.html", "capture/capture.css", "capture/capture.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
