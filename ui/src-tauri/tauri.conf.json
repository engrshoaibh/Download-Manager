{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Download Manager Pro",
  "version": "0.1.6",
  "identifier": "com.highperf.dm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Download Manager Pro",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Shoaib Hassan",
    "resources": [
      "dm-daemon.exe",
      "dm-native-host.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["dmpro"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1Nzk0REYyQUMwOENFMjUKUldRbHpnaXM4azE1NVd1dWxoTGg4RVZPZURXeC9vem50STVjdUxmUUxnellJRjk1cklJeTVveW4K",
      "endpoints": [
        "https://github.com/engrshoaibh/Download-Manager/releases/latest/download/updater.json"
      ]
    }
  }
}
